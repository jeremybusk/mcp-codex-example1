FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global opencode-ai@latest
COPY docker/opencode-entrypoint.sh /usr/local/bin/opencode-entrypoint
RUN chmod 755 /usr/local/bin/opencode-entrypoint
ENV HOME=/opencode
ENV OPENCODE_CONFIG=/opencode/opencode.json
WORKDIR /workspace
ENTRYPOINT ["opencode-entrypoint"]
CMD ["sleep", "infinity"]
