# PostgreSQL account should be read-only; the MCP server also forces read-only transactions.
DATABASE_URL=postgresql://readonly_user:change-me@db.example.internal:5432/appdb

SSH_HOST=server.example.internal
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_FILE=./.ssh/mcp
SSH_KNOWN_HOSTS_FILE=./.ssh/known_hosts

# Web UI. Generate the hash with the command documented in README.md.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST=localhost
WEB_PORT=8443
WEB_USERNAME=admin
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
